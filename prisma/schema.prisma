generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  price       String?
  description String
  image       String
  benefits    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
